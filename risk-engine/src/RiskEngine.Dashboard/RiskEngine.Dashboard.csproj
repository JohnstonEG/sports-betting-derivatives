<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>RiskEngine.Dashboard</RootNamespace>
    <AssemblyName>RiskEngine.Dashboard</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\RiskEngine.Core\RiskEngine.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\data\calibration.json" Link="data\calibration.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <None Include="..\..\data\portfolio.json" Link="data\portfolio.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
